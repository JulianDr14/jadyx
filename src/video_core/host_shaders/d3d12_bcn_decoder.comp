#version 450

// Decodes the guest's block-linear BC1-5 and BC7 blocks straight into the plain texels the D3D12
// backend keeps for BC arrays (DecodedBcFormat): R8 for BC4, R8G8 for BC5, RGBA8 for the rest.
// One invocation decodes one 4x4 block, gl_GlobalInvocationID.z is the layer. The results are
// the CPU decoder's bytes (externals/bc_decoder and VideoCommon::GuestBc1Palette), integer
// rounding included, so both paths can be switched without the textures changing.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint mode;              // BCN_* in bits 0-3, BCN_SIGNED and BCN_GUEST_PALETTE
    uint layer_stride;
    uint block_size;
    uint x_shift;
    uint block_height;
    uint block_height_mask;
    uint input_words;
    uint blocks_x;
    uint blocks_y;
};

layout(binding = 0, std430) readonly restrict buffer InputBuffer {
    uint input_data[];
};

layout(binding = 1) uniform writeonly restrict image2DArray dest_image;

const uint BCN_BC1 = 1u;
const uint BCN_BC2 = 2u;
const uint BCN_BC3 = 3u;
const uint BCN_BC4 = 4u;
const uint BCN_BC5 = 5u;
const uint BCN_BC7 = 7u;
const uint BCN_SIGNED = 16u;        // BC4 and BC5 SNORM
const uint BCN_GUEST_PALETTE = 32u; // BC1-3 colors from VideoCommon::GuestBc1Palette

const uint GOB_SIZE_X_SHIFT = 6;
const uint GOB_SIZE_Y_SHIFT = 3;
const uint GOB_SIZE_SHIFT = GOB_SIZE_X_SHIFT + GOB_SIZE_Y_SHIFT;

uint SwizzleOffset(uvec2 pos) {
    return ((pos.x & 32u) << 3u) |
           ((pos.y & 6u)  << 5u) |
           ((pos.x & 16u) << 1u) |
           ((pos.y & 1u)  << 4u) |
           (pos.x & 15u);
}

uvec3 Expand565(uint color) {
    const uint r = (color >> 11u) & 31u;
    const uint g = (color >> 5u) & 63u;
    const uint b = color & 31u;
    return uvec3((r << 3u) | (r >> 2u), (g << 2u) | (g >> 4u), (b << 3u) | (b >> 2u));
}

// GuestBc1Palette's rounding: 5-bit channels from their raw values, 6-bit ones from the expanded.
int GuestThird5(int a, int b) { return ((2 * a + b) * 22) / 8; }
int GuestThird6(int a, int b) { return (256 * a + (b - a) / 4 + 128 + (b - a) * 80) / 256; }
int GuestHalf5(int a, int b) { return ((a + b) * 33) / 8; }
int GuestHalf6(int a, int b) { return (256 * a + (b - a) / 4 + 128 + (b - a) * 128) / 256; }

/// The four RGBA8 colors of a BC1 color block (two words). separate_alpha: BC2 and BC3's color
/// half, which always has four colors and no transparent one.
void ColorPalette(uint word0, bool separate_alpha, bool guest, out uvec4 colors[4]) {
    const uint c0 = word0 & 0xFFFFu;
    const uint c1 = word0 >> 16u;
    const uvec3 e0 = Expand565(c0);
    const uvec3 e1 = Expand565(c1);
    colors[0] = uvec4(e0, 255u);
    colors[1] = uvec4(e1, 255u);
    const bool four_colors = separate_alpha || c0 > c1;
    if (guest) {
        const ivec3 r0 = ivec3(c0 >> 11u, (c0 >> 5u) & 63u, c0 & 31u);
        const ivec3 r1 = ivec3(c1 >> 11u, (c1 >> 5u) & 63u, c1 & 31u);
        const int g0 = int(e0.g);
        const int g1 = int(e1.g);
        if (four_colors) {
            colors[2] = uvec4(GuestThird5(r0.x, r1.x), GuestThird6(g0, g1), GuestThird5(r0.z, r1.z),
                              255);
            colors[3] = uvec4(GuestThird5(r1.x, r0.x), GuestThird6(g1, g0), GuestThird5(r1.z, r0.z),
                              255);
        } else {
            colors[2] = uvec4(GuestHalf5(r0.x, r1.x), GuestHalf6(g0, g1), GuestHalf5(r0.z, r1.z),
                              255);
            colors[3] = uvec4(0u);
        }
        return;
    }
    if (four_colors) {
        colors[2] = uvec4((e0 * 2u + e1) / 3u, 255u);
        colors[3] = uvec4((e1 * 2u + e0) / 3u, 255u);
    } else {
        colors[2] = uvec4((e0 + e1) >> 1u, 255u);
        // Only BC1 has the transparent black; separate_alpha always took four colors.
        colors[3] = uvec4(0u);
    }
}

/// Palette entry index of one BC4 channel block (two words): 3 bits per texel from bit 16.
uint ChannelIndex(uint word0, uint word1, uint texel) {
    const uint bit = 16u + 3u * texel;
    if (bit + 3u <= 32u) {
        return (word0 >> bit) & 7u;
    }
    if (bit >= 32u) {
        return (word1 >> (bit - 32u)) & 7u;
    }
    return ((word0 >> bit) | (word1 << (32u - bit))) & 7u;
}

/// One texel of a BC4 channel block, as the byte the CPU decoder writes (signed ones as int).
int ChannelValue(uint word0, uint word1, uint texel, bool is_signed) {
    int e0 = int(word0 & 0xFFu);
    int e1 = int((word0 >> 8u) & 0xFFu);
    if (is_signed) {
        e0 = bitfieldExtract(int(word0), 0, 8);
        e1 = bitfieldExtract(int(word0), 8, 8);
    }
    const int i = int(ChannelIndex(word0, word1, texel));
    if (i == 0) {
        return e0;
    }
    if (i == 1) {
        return e1;
    }
    if (e0 > e1) {
        return ((8 - i) * e0 + (i - 1) * e1) / 7;
    }
    if (i < 6) {
        return ((6 - i) * e0 + (i - 1) * e1) / 5;
    }
    if (i == 6) {
        return is_signed ? -128 : 0;
    }
    return is_signed ? 127 : 255;
}

float ChannelFloat(int value, bool is_signed) {
    return is_signed ? max(float(value) / 127.0, -1.0) : float(value) / 255.0;
}

// BC7 (ARB_texture_compression_bptc), laid out as externals/bc_decoder's BC7::Block.

