    0xAA444444u, 0x54A854A8u, 0x95809580u, 0x96969600u, 0xA85454A8u, 0x80959580u, 0xAA141414u, 0x96960000u,
    0xAAAA1414u, 0xA05050A0u, 0xA0A5A5A0u, 0x96000000u, 0x40804080u, 0xA9A8A9A8u, 0xAAAAAA44u, 0x2A4A5254u);

const uint ANCHORTABLE2[64] = uint[](
    15u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 15u,
    15u, 2u, 8u, 2u, 2u, 8u, 8u, 15u, 2u, 8u, 2u, 2u, 8u, 8u, 2u, 2u,
    15u, 15u, 6u, 8u, 2u, 8u, 15u, 15u, 2u, 8u, 2u, 2u, 2u, 15u, 15u, 6u,
    6u, 2u, 6u, 8u, 15u, 15u, 2u, 2u, 15u, 15u, 15u, 15u, 15u, 2u, 2u, 15u);

const uint ANCHORTABLE3A[64] = uint[](
    3u, 3u, 15u, 15u, 8u, 3u, 15u, 15u, 8u, 8u, 6u, 6u, 6u, 5u, 3u, 3u,
    3u, 3u, 8u, 15u, 3u, 3u, 6u, 10u, 5u, 8u, 8u, 6u, 8u, 5u, 15u, 15u,
    8u, 15u, 3u, 5u, 6u, 10u, 8u, 15u, 15u, 3u, 15u, 5u, 15u, 15u, 15u, 15u,
    3u, 15u, 5u, 5u, 5u, 8u, 5u, 10u, 5u, 10u, 8u, 13u, 15u, 12u, 3u, 3u);

const uint ANCHORTABLE3B[64] = uint[](
    15u, 8u, 8u, 3u, 15u, 15u, 3u, 8u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 8u,
    15u, 8u, 15u, 3u, 15u, 8u, 15u, 8u, 3u, 15u, 6u, 10u, 15u, 15u, 10u, 8u,
    15u, 3u, 15u, 10u, 10u, 8u, 9u, 10u, 6u, 15u, 8u, 15u, 3u, 6u, 6u, 8u,
    15u, 3u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 15u, 3u, 15u, 15u, 8u);

// Per mode: subsets, partition bits, rotation bits, index selection bits, color bits, alpha bits,
// endpoint p-bits, shared p-bits, primary and secondary index bits.
const uint BC7_NS[8] = uint[](3u, 2u, 3u, 2u, 1u, 1u, 1u, 2u);
const uint BC7_PB[8] = uint[](4u, 6u, 6u, 6u, 0u, 0u, 0u, 6u);
const uint BC7_RB[8] = uint[](0u, 0u, 0u, 0u, 2u, 2u, 0u, 0u);
const uint BC7_ISB[8] = uint[](0u, 0u, 0u, 0u, 1u, 0u, 0u, 0u);
const uint BC7_CB[8] = uint[](4u, 6u, 5u, 7u, 5u, 7u, 7u, 5u);
const uint BC7_AB[8] = uint[](0u, 0u, 0u, 0u, 6u, 8u, 7u, 5u);
const uint BC7_EPB[8] = uint[](1u, 0u, 0u, 1u, 0u, 0u, 1u, 1u);
const uint BC7_SPB[8] = uint[](0u, 1u, 0u, 0u, 0u, 0u, 0u, 0u);
const uint BC7_IB[8] = uint[](3u, 3u, 2u, 2u, 2u, 2u, 4u, 2u);
const uint BC7_IB2[8] = uint[](0u, 0u, 0u, 0u, 3u, 2u, 0u, 0u);

const uint BC7_WEIGHTS2[4] = uint[](0u, 21u, 43u, 64u);
const uint BC7_WEIGHTS3[8] = uint[](0u, 9u, 18u, 27u, 37u, 46u, 55u, 64u);
const uint BC7_WEIGHTS4[16] = uint[](0u, 4u, 9u, 13u, 17u, 21u, 26u, 30u,
                                     34u, 38u, 43u, 47u, 51u, 55u, 60u, 64u);

/// count (< 32) bits of the 128-bit block from bit offset.
uint Bits(uvec4 block, uint offset, uint count) {
    if (count == 0u) {
        return 0u;
    }
    const uint word = offset >> 5u;
    const uint shift = offset & 31u;
    uint value = block[word] >> shift;
    if (shift + count > 32u && word < 3u) {
        value |= block[word + 1u] << (32u - shift);
    }
    return value & ((1u << count) - 1u);
}

uint Bc7Weight(uint index, uint bits) {
    if (bits == 2u) {
        return BC7_WEIGHTS2[index];
    }
    if (bits == 3u) {
        return BC7_WEIGHTS3[index];
    }
    return BC7_WEIGHTS4[index];
}

uint Bc7Interpolate(uint e0, uint e1, uint index, uint bits) {
    const uint weight = Bc7Weight(index, bits);
    return ((64u - weight) * e0 + weight * e1 + 32u) >> 6u;
}

void DecodeBc7(uvec4 block, ivec3 coord, ivec2 size) {
    const uint low = block.x & 0xFFu;
    if (low == 0u) {
        // Invalid mode: transparent black.
        for (int j = 0; j < 4; ++j) {
            for (int i = 0; i < 4; ++i) {
                if (coord.x + i < size.x && coord.y + j < size.y) {
                    imageStore(dest_image, coord + ivec3(i, j, 0), vec4(0.0));
                }
            }
        }
        return;
    }
    const uint m = uint(findLSB(low));
    const uint ns = BC7_NS[m];
    const uint cb = BC7_CB[m];
    const uint ab = BC7_AB[m];
    const uint epb = BC7_EPB[m];
    const uint spb = BC7_SPB[m];
    const uint num_colors = ns * 2u;

    const uint partition_offset = m + 1u;
    const uint partition_id = Bits(block, partition_offset, BC7_PB[m]);
    const uint rotation_offset = partition_offset + BC7_PB[m];
    const uint rotation = Bits(block, rotation_offset, BC7_RB[m]);
    const uint selection_offset = rotation_offset + BC7_RB[m];
    const uint selection = Bits(block, selection_offset, BC7_ISB[m]);
    const uint red_offset = selection_offset + BC7_ISB[m];
    const uint green_offset = red_offset + cb * num_colors;
    const uint blue_offset = green_offset + cb * num_colors;
    const uint alpha_offset = blue_offset + cb * num_colors;
    const uint pbit_offset = alpha_offset + ab * num_colors;
    const uint shared_offset = pbit_offset + epb * num_colors;
    const uint primary_offset = shared_offset + spb * 2u;
    const uint secondary_offset = primary_offset + 16u * BC7_IB[m] - ns;

    uvec4 endpoints[6];
    for (uint i = 0u; i < num_colors; ++i) {
        uvec4 color = uvec4(Bits(block, red_offset + cb * i, cb),
                            Bits(block, green_offset + cb * i, cb),
                            Bits(block, blue_offset + cb * i, cb),
                            ab > 0u ? Bits(block, alpha_offset + ab * i, ab) : 255u);
        if (spb > 0u) {
            // Shared per subset: endpoints 0-1 take the first bit, 2-3 the second.
            color.rgb = (color.rgb << 1u) | Bits(block, shared_offset + i / 2u, 1u);
        }
        if (epb > 0u) {
            const uint pbit = Bits(block, pbit_offset + i, 1u);
            color.rgb = (color.rgb << 1u) | pbit;
            if (ab > 0u) {
                color.a = (color.a << 1u) | pbit;
            }
        }
        const uint color_bits = cb + spb + epb;
        color.rgb = (color.rgb << (8u - color_bits)) & 0xFFu;
        color.rgb = color.rgb | (color.rgb >> color_bits);
        if (ab > 0u) {
            const uint alpha_bits = ab + spb + epb;
            color.a = (color.a << (8u - alpha_bits)) & 0xFFu;
            color.a = color.a | (color.a >> alpha_bits);
        }
        endpoints[i] = color;
    }

    // Anchors store one bit less, so each texel's index position depends on the ones before it.
    const bool color_secondary = selection == 1u;
    const bool alpha_secondary = BC7_IB2[m] != 0u && selection == 0u;
    const uint color_bits = color_secondary ? BC7_IB2[m] : BC7_IB[m];
    const uint alpha_bits = alpha_secondary ? BC7_IB2[m] : BC7_IB[m];
    const uint color_base = color_secondary ? secondary_offset : primary_offset;
    const uint alpha_base = alpha_secondary ? secondary_offset : primary_offset;
    uint color_cursor = 0u;
    uint alpha_cursor = 0u;
    for (uint texel = 0u; texel < 16u; ++texel) {
        uint subset = 0u;
        if (ns == 2u) {
            subset = (PARTITIONTABLE2[partition_id] >> (2u * texel)) & 3u;
        } else if (ns == 3u) {
            subset = (PARTITIONTABLE3[partition_id] >> (2u * texel)) & 3u;
        }
        uint anchor = 0u;
        if (subset == 1u) {
            anchor = ns == 2u ? ANCHORTABLE2[partition_id] : ANCHORTABLE3A[partition_id];
        } else if (subset == 2u) {
            anchor = ANCHORTABLE3B[partition_id];
        }
        const uint anchor_bit = anchor == texel ? 1u : 0u;
        const uint color_read = color_bits - anchor_bit;
        const uint alpha_read = alpha_bits - anchor_bit;
        const uint color_index = Bits(block, color_base + color_cursor, color_read);
        const uint alpha_index = Bits(block, alpha_base + alpha_cursor, alpha_read);
        color_cursor += color_read;
        alpha_cursor += alpha_read;

        const uvec4 e0 = endpoints[subset * 2u];
        const uvec4 e1 = endpoints[subset * 2u + 1u];
        uvec4 texel_color = uvec4(Bc7Interpolate(e0.r, e1.r, color_index, color_bits),
                                  Bc7Interpolate(e0.g, e1.g, color_index, color_bits),
                                  Bc7Interpolate(e0.b, e1.b, color_index, color_bits),
                                  Bc7Interpolate(e0.a, e1.a, alpha_index, alpha_bits));
        if (rotation == 1u) {
            texel_color = texel_color.agbr;
        } else if (rotation == 2u) {
            texel_color = texel_color.rabg;
        } else if (rotation == 3u) {
            texel_color = texel_color.rgab;
        }
        const ivec2 local = ivec2(texel & 3u, texel >> 2u);
        if (coord.x + local.x < size.x && coord.y + local.y < size.y) {
            imageStore(dest_image, coord + ivec3(local, 0), vec4(texel_color) / 255.0);
        }
    }
}

void main() {
    const uvec3 block_pos = gl_GlobalInvocationID;
    if (block_pos.x >= blocks_x || block_pos.y >= blocks_y) {
        return;
    }
    const ivec3 coord = ivec3(block_pos.xy * 4u, block_pos.z);
    const ivec2 size = imageSize(dest_image).xy;
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }
    const uint format = mode & 15u;
    const bool is_signed = (mode & BCN_SIGNED) != 0u;
    const bool guest = (mode & BCN_GUEST_PALETTE) != 0u;
    const uint bytes_log2 = format == BCN_BC1 || format == BCN_BC4 ? 3u : 4u;

    const uvec2 pos = uvec2(block_pos.x << bytes_log2, block_pos.y);
    const uint block_y = pos.y >> GOB_SIZE_Y_SHIFT;
    uint offset = block_pos.z * layer_stride;
    offset += (block_y >> block_height) * block_size;
    offset += (block_y & block_height_mask) << GOB_SIZE_SHIFT;
    offset += (pos.x >> GOB_SIZE_X_SHIFT) << x_shift;
    offset += SwizzleOffset(pos);

    // The raw view is bounded already; a malformed layout still reads zeros, not past it.
    const uint word = offset / 4u;
    const uint words = 1u << (bytes_log2 - 2u);
    uvec4 block = uvec4(0u);
    if (word + words <= input_words) {
        block.x = input_data[word];
        block.y = input_data[word + 1u];
        if (words == 4u) {
            block.z = input_data[word + 2u];
            block.w = input_data[word + 3u];
        }
    }

    if (format == BCN_BC7) {
        DecodeBc7(block, coord, size);
        return;
    }
    uvec4 colors[4];
    if (format == BCN_BC1) {
        ColorPalette(block.x, false, guest, colors);
    } else if (format == BCN_BC2 || format == BCN_BC3) {
        ColorPalette(block.z, true, guest, colors);
    }
    for (uint texel = 0u; texel < 16u; ++texel) {
        const ivec2 local = ivec2(texel & 3u, texel >> 2u);
        if (coord.x + local.x >= size.x || coord.y + local.y >= size.y) {
            continue;
        }
        vec4 value;
        if (format == BCN_BC4) {
            value = vec4(ChannelFloat(ChannelValue(block.x, block.y, texel, is_signed), is_signed),
                         0.0, 0.0, 1.0);
        } else if (format == BCN_BC5) {
            value = vec4(ChannelFloat(ChannelValue(block.x, block.y, texel, is_signed), is_signed),
                         ChannelFloat(ChannelValue(block.z, block.w, texel, is_signed), is_signed),
                         0.0, 1.0);
        } else {
            const uint indices = format == BCN_BC1 ? block.y : block.w;
            uvec4 color = colors[(indices >> (2u * texel)) & 3u];
            if (format == BCN_BC2) {
                const uint nibble = Bits(block, 4u * texel, 4u);
                color.a = nibble | (nibble << 4u);
            } else if (format == BCN_BC3) {
                color.a = uint(ChannelValue(block.x, block.y, texel, false));
            }
            value = vec4(color) / 255.0;
        }
        imageStore(dest_image, coord + ivec3(local, 0), value);
    }
}
